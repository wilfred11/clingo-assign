% values.lp
sex(female).
sex(male).
sex(na).
married_status(divorced).
married_status(single).
married_status(married).
married_status(widowed).
married_status(na).
job(software_engineer).
job(accountant).
job(graphic_designer).
job(marketing_specialist).
job(project_manager).
job(na).
religion(other).
religion(buddhism).
religion(christianity).
religion(hinduism).
religion(islam).
religion(na).
val(na).

% columns.lp
column(sex).
column(married_status).
column(job).
column(religion).

% priority-deletion-rank.lp
deletion_rank(priority_number(1,1),1).
deletion_rank(priority_number(2,1),2).
deletion_rank(priority_number(2,2),3).
deletion_rank(priority_number(3,1),4).

% col-combs.lp
comb(col_priority(job,1,1),1).
comb(col_priority(religion,2,1),1).
comb(col_priority(married_status,2,2),1).
comb(col_priority(sex,3,1),1).
comb(col_priority(job,1,1),2).
comb(col_priority(married_status,2,1),2).
comb(col_priority(religion,2,2),2).
comb(col_priority(sex,3,1),2).
comb(1)|comb(2).

del_c(0)|del_c(1)|del_c(2)|del_c(3)|del_c(4).

% col-specific-hide.lp
p_sex_(X,na) :- p_sex(X,_), hide_column(sex,_).
p_sex_(X,Y) :- p_sex(X,Y), not hide_column(sex,_).
p_married_status_(X,na) :- p_married_status(X,_), hide_column(married_status,_).
p_married_status_(X,Y) :- p_married_status(X,Y), not hide_column(married_status,_).
p_job_(X,na) :- p_job(X,_), hide_column(job,_).
p_job_(X,Y) :- p_job(X,Y), not hide_column(job,_).
p_religion_(X,na) :- p_religion(X,_), hide_column(religion,_).
p_religion_(X,Y) :- p_religion(X,Y), not hide_column(religion,_).
count_ext(X0,X1,X2,X3,N) :-sex(X0),married_status(X1),job(X2),religion(X3),N=#count{X: p_sex_(X,X0),p_married_status_(X,X1),p_job_(X,X2),p_religion_(X,X3)}.
count_ext_(X0,X1,X2,X3,N) :- count_ext(X0,X1,X2,X3,N), N!=0.
sum_test(N1) :- N1=#sum{N,X0,X1,X2,X3 : count_ext(X0,X1,X2,X3,N)}.
min(N1) :- N1=#min{N:count_ext_(X0,X1,X2,X3,N)}.


% search-constraints.lp
queue(priority_number(X,Y),CN) :-  deletion_rank(priority_number(X,Y),CN),  CN<=S, del_c(S).
col_priority_comb(C,X,Y,V) :- queue(priority_number(X1,Y1),CN), comb(col_priority(C,X,Y),V), comb(V), column(C), X=X1, Y=Y1.

hide_column(C,N) :- col_priority_comb(C,X,Y,N), comb(N).

:- k>N1, min(N1).

#minimize {X:del_c(X)}.

#show hide_column/2.
#show comb/1.
#show person/1.
#show p_religion_/2.
#show p_job_/2.
#show p_sex_/2.
#show p_married_status_/2.
#show val/1.
#show sum_test/1.
#show min/1.
#show del_c/1.